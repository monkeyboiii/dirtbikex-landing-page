---
import { readFileSync } from 'node:fs';
import { join } from 'node:path';
import '../styles/map.css';
import Footer from './Footer.astro';
import { getLangFromUrl, localizedPath } from '../i18n/utils';
import { ui, defaultLang } from '../i18n/ui';
import { SOCIALS, FORUM_BASE } from '../config';
import { LAYER_DEFAULTS, LAYER_IDS } from '../scripts/worldmap/types';

/** English source of every map string; per-locale overrides come from src/i18n/locales. */
const DEFAULTS: Record<string, string> = {
  'map.hud.series': 'Visiting 100 dirt bike tracks',
  'map.hud.counter': '{done} / {total}',
  'map.hud.seriesMode': 'Series mode',
  'map.hud.worldMode': 'Back to the world',
  'map.panel.close': 'Close',
  'map.panel.inProduction': 'Episode in production',
  'map.panel.watch': 'Watch',
  'map.panel.trackInfo': 'Track info',
  'map.panel.verified': 'Verified',
  'map.panel.claimed': 'Claimed by its steward',
  'map.panel.approxArea': 'Approximate area',
  'map.panel.website': 'Website',
  'map.panel.join': 'Join DirtBikeX',
  'map.cat.motocross': 'Motocross track',
  'map.cat.riding_park': 'Riding park',
  'map.cat.ebike_park': 'E-bike park',
  'map.cat.club': 'Club',
  'map.cat.trail_area': 'Trail area',
  'map.cat.other': 'Riding spot',
  'map.drawer.about': 'About',
  'map.drawer.intro':
    'DirtBikeX is a community for dirt bike riders — tracks, trails, and the people who ride them. Every pin on this map is a real place.',
  'map.drawer.close': 'Close',
  'map.control.recenter': 'Back to the latest episode',
  'map.search.open': 'Search',
  'map.upload.open': 'Add your trail',
  'map.upload.kicker': 'Your trail',
  'map.upload.title': 'Put your ride on the map',
  'map.upload.body':
    'Drop a .gpx file and we will draw it. It stays private to you until you decide to make it public.',
  'map.upload.pick': 'Choose a .gpx file',
  'map.upload.rename': 'Rename',
  'map.upload.confirm': 'Confirm',
  'map.upload.chooseAnother': 'Choose a different file',
  'map.upload.ready': 'Ready to upload',
  'map.upload.expiresChip': 'Expires in {n} h',
  'map.upload.yours': 'Your recent uploads',
  'map.upload.reopen': 'open',
  'map.upload.confirmClose': 'Kept on this device only. Close without sharing or claiming?',
  'map.upload.delete': 'Delete',
  'map.upload.forget': 'Forget',
  'map.upload.confirmDelete':
    'Delete this trail? Anyone holding the link loses it too, and this cannot be undone.',
  'map.upload.callToClaim':
    'You did it! Share it with anyone you like. One more step to make it yours — right now nobody knows who uploaded it.',
  'map.upload.verifying': 'Checking you are human\u2026',
  'map.trail.anonymous': 'Anonymous',
  'map.trail.anonymousMeta': 'nobody has claimed this ride',
  'map.trail.visibleOnMap': 'On the public map',
  'map.trail.hiddenFromMap': 'Not on the map — link only',
  'map.upload.drop': 'Drop your .gpx here',
  'map.upload.working': 'Uploading\u2026',
  'map.upload.phase.reading': 'Reading your file\u2026',
  'map.upload.phase.measuring': 'Measuring the ride\u2026',
  'map.upload.phase.sending': 'Sending it\u2026',
  'map.upload.phase.finishing': 'Almost there\u2026',
  'map.upload.doneTitle': 'One more step to go public!',
  'map.upload.expires': 'Unclaimed, it is deleted in {n} hours.',
  'map.upload.you': 'You',
  'map.upload.yourNameHere': 'your name here',
  'map.upload.claimShort': 'Claim',
  'map.upload.unavailable': 'Trail upload is switched off right now',
  'map.upload.unavailableBody':
    'Uploading is paused on this site. Nothing you have already shared is affected — your links still work.',
  'map.upload.failed': 'That file could not be added',
  'map.upload.errNoTrack':
    'That file has no recorded track in it \u2014 only a planned route, or waypoints, or a trace that never moved.',
  'map.upload.errTooBig': 'That file is larger than 10 MB.',
  'map.upload.errBusy': 'Too many uploads from here just now. Try again in a few minutes.',
  'map.upload.errFailed': 'That did not go through. Try again.',
  'map.trail.goneTitle': 'This trail is no longer here',
  'map.basemap.title': 'Map style',
  'map.control.title': 'Map controls',
  'map.locate.blockedTitle': 'Your browser is blocking location',
  'map.locate.blockedBody':
    'This site was refused permission, and only the browser can give it back — look for the site settings beside the address bar, allow location there, then try again.',
  'map.basemap.auto': 'DirtBikeX',
  'map.basemap.autoNote': 'Follows the page theme',
  'map.basemap.topo': 'Topographic',
  'map.basemap.topoNote': 'Hillshade and contours',
  'map.basemap.liberty': 'Streets',
  'map.basemap.libertyNote': 'Plain and fast',
  'map.upload.claimedTitle': 'This one is yours now',
  'map.upload.claimedBody':
    'It is signed, so it no longer needs this list to survive — your message on the forum holds the file and decides whether it shows on the map. Removed from this device.',
  'map.trail.goneBody':
    'A shared trail lives for a few days unless its rider claims it. This link has expired, or never pointed anywhere.',
  'map.search.placeholder': 'Search tracks, trails, shops',
  'map.search.all': 'All',
  'map.search.empty': 'Nothing matched',
  'map.control.locate': 'Show where I am',
  'map.control.locateDenied': 'Location is blocked in your browser settings',
  'map.layer.title': 'Layers',
  'map.layer.tracks': 'Tracks',
  'map.layer.ride': 'The 100 challenge',
  'map.layer.trails': 'Rider trails',
  'map.layer.shops': 'Shops',
  'map.layer.riders': 'Riders',
  'map.trail.rider': 'Rider',
  // These four were translated in all 21 locale files and still rendered English, because
  // DEFAULTS is not a fallback table — it is the ALLOWLIST. `dict` is seeded from it and
  // the overlay loop iterates Object.keys(DEFAULTS), so a key absent here can never reach
  // the island however well it is translated. Anything the island asks for must be listed.
  'map.trail.uploadedBy': 'Uploaded by',
  'map.track.owner': 'Owner',
  'map.panel.share': 'Share',
  'map.panel.shareCopied': 'Link copied',
  'map.trail.thread': 'Forum thread',
  'map.trail.studio': 'Open in gpx.studio',
  'map.panel.watchOn': 'Watch on',
  'map.panel.recommended': 'Recommended',
  'map.panel.prev': 'Previous episode',
  'map.panel.next': 'Next episode',
  'map.panel.back': 'Back',
  'map.panel.venue': 'About this place',
  'map.panel.directions': 'Directions',
  'map.panel.openIn': 'Open in',
  'map.panel.systemMaps': 'Default map app',
  'map.trail.kicker': 'Rider trail',
  'map.trail.distance': 'Distance',
  'map.trail.rideTime': 'Ride time',
  'map.trail.climb': 'Climb',
  'map.trail.recordedOn': 'Recorded {date}',
  'map.trail.plotted': 'Plotted route',
  'map.trail.loop': 'Loop',
  'map.trail.pointToPoint': 'Point to point',
  'map.trail.sections': '{n} sections',
  'map.boot.loading': 'Loading the world',
  'map.a11y.map': 'Interactive world map of dirt bike tracks',
  'map.legend.tracks': '{count} tracks on the map',
  'map.err.unavailable': "The map couldn't load here. Explore DirtBikeX below.",
};

const lang = getLangFromUrl(Astro.url);
const dict: Record<string, string> = { ...DEFAULTS };
for (const key of Object.keys(DEFAULTS)) {
  const localised = (ui[lang] as Record<string, string>)[key] ?? (ui[defaultLang] as Record<string, string>)[key];
  if (localised) dict[key] = localised;
}
const s = (key: string) => dict[key] ?? key;

// Baked at build time so the gate and drawer show a real number before any fetch.
// Resolved from the project root — `import.meta.url` points into Astro's compiled
// output, not src/, so a relative URL misses the file and silently yields 0.
let trackCount = 0;
try {
  const raw = readFileSync(join(process.cwd(), 'public/map/tracks.json'), 'utf8');
  trackCount = (JSON.parse(raw).features ?? []).length;
} catch {
  trackCount = 0;
}

/** The rail's pressed state is a real icon swap, not a struck-through hack. */
const railIcon = (file: string) => {
  try {
    return readFileSync(join(process.cwd(), `public/map/markers/${file}.svg`), 'utf8');
  } catch {
    return '';
  }
};
// `pressed` comes from the island's own defaults, never a second hardcoded list —
// otherwise the server-rendered rail can disagree with the map it controls.
const RAIL_ICONS: Record<string, string> = {
  tracks: 'flag',
  trails: 'trails',
  shops: 'shop',
  ride: 'trophy',
  riders: 'rider',
};
const RAIL = LAYER_IDS.map((layer) => ({
  layer,
  on: railIcon(RAIL_ICONS[layer]!),
  off: railIcon(`${RAIL_ICONS[layer]!}-off`),
  label: s(`map.layer.${layer}`),
  pressed: LAYER_DEFAULTS[layer],
}));

const joinUrl = localizedPath(lang, '/join');
// Reuse the footer's existing label rather than minting a 21-locale key for it.
const forumLabel =
  (ui[lang] as Record<string, string>)['footer.forum'] ??
  (ui[defaultLang] as Record<string, string>)['footer.forum'] ??
  'Web forum';
const config = {
  lang,
  styleDarkUrl: '/map/style-dark.json',
  styleLightUrl: '/map/style-light.json',
  tracksUrl: '/map/tracks.json',
  seriesUrl: '/api/map/series.json',
  trailsUrl: '/api/map/trails.json',
  ridersUrl: '/api/lineage/riders.json',
  shopsUrl: '/api/map/shops.json',
  forumBase: FORUM_BASE,
  markersBase: '/map/markers/',
  // Episode links win; these profiles are the fallback, /contact the last resort.
  socials: {
    facebook: SOCIALS.facebook,
    instagram: SOCIALS.instagram,
    tiktok: SOCIALS.tiktok,
    douyin: SOCIALS.douyin,
  },
  contactUrl: localizedPath(lang, '/contact'),
  claimed: [] as string[],
};
---

<div id="worldmap" class="wm" data-worldmap>
  <div class="wm__canvas" data-map-canvas role="application" aria-label={s('map.a11y.map')}></div>
  <div class="wm__grade" aria-hidden="true"></div>

  <div class="wm__gate" data-map-gate data-state="idle">
    <div class="wm__gate-inner">
      <img src="/brand/logo-mark.svg" alt="" class="wm__gate-mark" />
      <p class="wm__gate-title">{s('map.hud.series')}</p>
      <p class="wm__gate-sub">
        {trackCount > 0 ? s('map.legend.tracks').replace('{count}', trackCount.toLocaleString(lang)) : ''}
      </p>
      <div
        class="wm__gate-bar"
        data-gate-bar
        role="progressbar"
        aria-valuemin="0"
        aria-valuemax="100"
        aria-valuenow="0"
        aria-label={s('map.boot.loading')}
      >
        <span class="wm__gate-fill" data-gate-fill></span>
      </div>
      <p class="wm__gate-error">{s('map.err.unavailable')}</p>
    </div>
  </div>

  {/* Two rails, split by what they do. LEFT changes what the map is made of — which
      kinds of pin, and the ground under them — and stays folded until asked, because
      nine buttons in one column is most of a phone's height. RIGHT is the four things
      you DO to the map, always out. */}
  <nav class="wm-rail wm-rail--left" data-rail aria-label={s('map.layer.title')}>
    <div class="wm-rail__group" data-layer-group>
      <button
        type="button"
        class="wm-rail__btn wm-rail__btn--action wm-rail__btn--fold"
        data-layers-toggle
        aria-expanded="false"
        title={s('map.layer.title')}
        aria-label={s('map.layer.title')}
      >
        <span class="wm-rail__chev wm-rail__fold-open" set:html={`<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15.536 11.293a1 1 0 0 0 0 1.414l2.376 2.377a1 1 0 0 0 1.414 0l2.377-2.377a1 1 0 0 0 0-1.414l-2.377-2.377a1 1 0 0 0-1.414 0z"/><path d="M2.297 11.293a1 1 0 0 0 0 1.414l2.377 2.377a1 1 0 0 0 1.414 0l2.377-2.377a1 1 0 0 0 0-1.414L6.088 8.916a1 1 0 0 0-1.414 0z"/><path d="M8.916 17.912a1 1 0 0 0 0 1.415l2.377 2.376a1 1 0 0 0 1.414 0l2.377-2.376a1 1 0 0 0 0-1.415l-2.377-2.376a1 1 0 0 0-1.414 0z"/><path d="M8.916 4.674a1 1 0 0 0 0 1.414l2.377 2.376a1 1 0 0 0 1.414 0l2.377-2.376a1 1 0 0 0 0-1.414l-2.377-2.377a1 1 0 0 0-1.414 0z"/></svg>`} />
        {/* Folded, the mark is the whole affordance; open, the chevron is — neither
            state needs both, and the button changes shape to say which it is in. */}
        <span class="wm-rail__chev wm-rail__fold-close" set:html={`<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>`} />
        <span class="wm-rail__badge" data-layer-count aria-hidden="true"></span>
        <span class="wm-rail__label">{s('map.layer.title')}</span>
      </button>
      {RAIL.map((item) => (
        <button
          type="button"
          class="wm-rail__btn wm-rail__btn--layer"
          data-layer={item.layer}
          aria-pressed={String(item.pressed)}
        >
          <span class="wm-rail__on" set:html={item.on} />
          <span class="wm-rail__off" set:html={item.off} />
          <span class="wm-rail__label">{item.label}</span>
        </button>
      ))}
    </div>
    <div class="wm-rail__group">
      <button type="button" class="wm-rail__btn wm-rail__btn--action" data-basemap aria-expanded="false" title={s('map.basemap.title')} aria-label={s('map.basemap.title')}>
        <span class="wm-rail__on" set:html={`<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12.83 2.18a2 2 0 0 0-1.66 0L2.6 6.08a1 1 0 0 0 0 1.83l8.58 3.91a2 2 0 0 0 1.66 0l8.58-3.9a1 1 0 0 0 0-1.83z"/><path d="M2 12a1 1 0 0 0 .58.91l8.6 3.91a2 2 0 0 0 1.65 0l8.58-3.9A1 1 0 0 0 22 12"/><path d="M2 17a1 1 0 0 0 .58.91l8.6 3.91a2 2 0 0 0 1.65 0l8.58-3.9A1 1 0 0 0 22 17"/></svg>`} />
        <span class="wm-rail__label">{s('map.basemap.title')}</span>
      </button>
    </div>
  </nav>

  <nav class="wm-rail wm-rail--right" aria-label={s('map.control.title')}>
    <button type="button" class="wm-rail__btn wm-rail__btn--action" data-search-toggle aria-expanded="false" title={s('map.search.open')} aria-label={s('map.search.open')}>
      <span class="wm-rail__on" set:html={`<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>`} />
      <span class="wm-rail__label">{s('map.search.open')}</span>
    </button>
    <button type="button" class="wm-rail__btn wm-rail__btn--action" data-upload title={s('map.upload.open')} aria-label={s('map.upload.open')}>
      <span class="wm-rail__on" set:html={`<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" x2="12" y1="3" y2="15"/></svg>`} />
      <span class="wm-rail__label">{s('map.upload.open')}</span>
    </button>
    <button type="button" class="wm-rail__btn wm-rail__btn--action" data-recenter title={s('map.control.recenter')} aria-label={s('map.control.recenter')}>
      <span class="wm-rail__on" set:html={`<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="2" x2="5" y1="12" y2="12"/><line x1="19" x2="22" y1="12" y2="12"/><line x1="12" x2="12" y1="2" y2="5"/><line x1="12" x2="12" y1="19" y2="22"/><circle cx="12" cy="12" r="7"/><circle cx="12" cy="12" r="3" fill="currentColor" stroke="none"/></svg>`} />
      <span class="wm-rail__label">{s('map.control.recenter')}</span>
    </button>
    <button
      type="button"
      class="wm-rail__btn wm-rail__btn--action wm-rail__btn--locate"
      data-locate
      data-state="idle"
      title={s('map.control.locate')}
      aria-label={s('map.control.locate')}
    >
      <span class="wm-rail__on" set:html={`<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polygon points="3 11 22 2 13 21 11 13 3 11"/></svg>`} />
      <span class="wm-rail__off" set:html={`<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M8.43 8.43 3 11l8 2 2 8 2.57-5.43"/><path d="M17.39 11.73 22 2l-9.73 4.61"/><line x1="2" x2="22" y1="2" y2="22"/></svg>`} />
      <span class="wm-rail__label">{s('map.control.locate')}</span>
    </button>
  </nav>

  {/* Only rendered while a file is over the map — see .wm__drop. */}
  <div class="wm__drop" data-drop hidden>{s('map.upload.drop')}</div>
  <input type="file" accept=".gpx,application/gpx+xml" data-upload-input hidden />

  {/* Opens where it is asked for: beside the rail on a wide screen, across the top
      on a phone, where a rail-width popover would be unusable. */}
  <div class="wm-search" data-search hidden>
    <div class="wm-search__bar">
      <svg class="wm-search__glass" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
      <input
        type="search"
        class="wm-search__input"
        data-search-input
        autocomplete="off"
        placeholder={s('map.search.placeholder')}
        aria-label={s('map.search.placeholder')}
      />
      <button type="button" class="wm-search__close" data-search-close aria-label={s('map.panel.close')}>
        <svg width="13" height="13" viewBox="0 0 14 14" aria-hidden="true"><path d="M2 2l10 10M12 2L2 12" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" /></svg>
      </button>
    </div>
    <div class="wm-search__filters" data-search-filters role="group" aria-label={s('map.layer.title')}></div>
    <ul class="wm-search__results" data-search-results role="listbox"></ul>
  </div>

  <section class="wm-hud" data-hud aria-label={s('map.hud.series')}>
    <button
      type="button"
      class="wm-hud__counter"
      data-hud-toggle
      aria-pressed="false"
      title={s('map.hud.seriesMode')}
    >
      <span data-hud-counter>—</span>
    </button>
    <div class="wm-hud__bar" data-hud-bar></div>
    <button type="button" class="wm-hud__label" data-hud-label></button>
  </section>

  <aside class="wm-panel" data-panel hidden aria-live="polite">
    {/* A real control line, not two absolutely-positioned buttons the title had to
        dodge: back left, what-this-is centred, close right. The title then starts
        on its own line and is free to wrap. */}
    <div class="wm-panel__controls">
      <button type="button" class="wm-panel__back" data-panel-back hidden aria-label={s('map.panel.back')}>
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"
          stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14.5 5.5 8 12l6.5 6.5" /></svg>
      </button>
      <span class="wm-panel__slot" data-panel-slot></span>
      <button type="button" class="wm-panel__close" data-panel-close aria-label={s('map.panel.close')}>
        <svg width="14" height="14" viewBox="0 0 14 14" aria-hidden="true"
          ><path d="M2 2l10 10M12 2L2 12" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" /></svg
        >
      </button>
    </div>
    <div class="wm-panel__body" data-panel-body></div>
  </aside>

  <div class="wm__drawer" data-drawer>
    <button type="button" class="wm__drawer-handle" data-drawer-toggle aria-expanded="false">
      <span class="wm__stats" data-stats>
        {trackCount > 0 && (
          <span data-stat-static><b>{trackCount.toLocaleString(lang)}</b> tracks</span>
        )}
        <span><b data-stat="users_count">—</b> riders</span>
        <span><b data-stat="topics_count">—</b> threads</span>
      </span>
      <span class="wm__drawer-label">
        {s('map.drawer.about')}
        <svg class="wm__drawer-chevron" width="12" height="12" viewBox="0 0 12 12" aria-hidden="true"
          ><path d="M2 4.5L6 8.5l4-4" stroke="currentColor" stroke-width="1.6" fill="none" stroke-linecap="round" /></svg
        >
      </span>
    </button>
    <div class="wm__drawer-body">
      <p class="wm__drawer-intro">{s('map.drawer.intro')}</p>
      <p class="wm__drawer-cta">
        <a class="is-lead" href={FORUM_BASE} target="_blank" rel="noopener">{forumLabel}</a>
        <a href={joinUrl}>{s('map.panel.join')}</a>
      </p>
      <Footer />
    </div>
  </div>

  <script type="application/json" id="worldmap-config" set:html={JSON.stringify(config)} is:inline></script>
  <script type="application/json" id="worldmap-i18n" set:html={JSON.stringify(dict)} is:inline></script>
</div>

<script>
  import { bootWorldMap } from '../scripts/worldmap/index';
  void bootWorldMap();
</script>
