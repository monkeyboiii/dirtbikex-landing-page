---
import { getLangFromUrl, useTranslations, localizedPath } from '../i18n/utils';
import { APP_STORE_URL, FORUM_BASE } from '../config';
import LangSwitcher from './LangSwitcher.astro';
import Icon from './Icon.astro';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const home = localizedPath(lang, '/');
---

<header class="site-header">
  <div class="container-narrow site-header__inner">
    <a href={home} class="site-brand">
      <img src="/brand/logo-lockup.svg" alt="DirtBikeX" class="site-brand__lockup" />
    </a>

    <nav class="site-nav">
      <a href={localizedPath(lang, '/founders')}>{t('nav.founders')}</a>
      <a href={localizedPath(lang, '/sponsorship')}>{t('nav.sponsorship')}</a>
      <a href={FORUM_BASE} target="_blank" rel="noopener">{t('nav.community')}</a>
    </nav>

    <div class="site-tools">
      <LangSwitcher />
      <button
        type="button"
        id="theme-toggle"
        aria-label={t('nav.toggleTheme')}
        class="icon-btn"
      >
        <span class="hidden dark:inline-flex"><Icon name="sun" size={18} /></span>
        <span class="inline-flex dark:hidden"><Icon name="moon" size={18} /></span>
      </button>
      <a
        href={APP_STORE_URL}
        target="_blank"
        rel="noopener"
        class="btn btn--primary site-getapp"
        aria-label={t('nav.getApp')}
      >
        <span class="site-getapp__icon">
          <svg class="site-getapp__mark" width="17" height="17" viewBox="0 0 24 24" aria-hidden="true">
            <path
              fill="currentColor"
              d="M17.05 12.54c.02-2.2 1.8-3.26 1.88-3.31-1.02-1.5-2.62-1.71-3.19-1.73-1.36-.14-2.65.8-3.34.8-.69 0-1.75-.78-2.87-.76-1.48.02-2.84.86-3.6 2.18-1.53 2.66-.39 6.6 1.1 8.76.73 1.06 1.6 2.25 2.74 2.2 1.1-.04 1.52-.71 2.85-.71s1.7.71 2.87.69c1.18-.02 1.93-1.08 2.65-2.14.84-1.23 1.18-2.42 1.2-2.48-.03-.01-2.29-.88-2.31-3.5ZM14.9 5.72c.6-.74 1.01-1.76.9-2.78-.87.04-1.93.58-2.56 1.31-.56.65-1.05 1.7-.92 2.7.97.07 1.97-.5 2.58-1.23Z"
            />
          </svg>
          <svg class="site-getapp__dl" width="17" height="17" viewBox="0 0 24 24" aria-hidden="true">
            <path
              d="M12 3.5v10.5m0 0 4-4m-4 4-4-4M4.5 16.5v2.2a2 2 0 0 0 2 2h11a2 2 0 0 0 2-2v-2.2"
              stroke="currentColor"
              stroke-width="2"
              fill="none"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
          </svg>
        </span>
        <span class="site-getapp__label">{t('nav.getApp')}</span>
      </a>
    </div>
  </div>
</header>

<script is:inline>
  document.getElementById('theme-toggle')?.addEventListener('click', () => {
    const root = document.documentElement;
    const isDark = root.classList.toggle('dark');
    try { localStorage.setItem('theme', isDark ? 'dark' : 'light'); } catch (e) {}
  });
  (function () {
    const header = document.querySelector('.site-header');
    if (!header) return;
    const sync = () => header.toggleAttribute('data-scrolled', window.scrollY > 8);
    window.addEventListener('scroll', sync, { passive: true });
    sync();
  })();
</script>
