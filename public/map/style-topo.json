{
  "version": 8,
  "name": "DirtBikeX Topographic",
  "glyphs": "https://tiles.openfreemap.org/fonts/{fontstack}/{range}.pbf",
  "sources": {
    "opentopomap": {
      "type": "raster",
      "tiles": [
        "https://a.tile.opentopomap.org/{z}/{x}/{y}.png",
        "https://b.tile.opentopomap.org/{z}/{x}/{y}.png",
        "https://c.tile.opentopomap.org/{z}/{x}/{y}.png"
      ],
      "tileSize": 256,
      "maxzoom": 17,
      "attribution": "<a href=\"https://opentopomap.org\" target=\"_blank\" rel=\"noopener\">OpenTopoMap</a> (<a href=\"https://creativecommons.org/licenses/by-sa/3.0/\" target=\"_blank\" rel=\"noopener\">CC-BY-SA</a>), Data from <a href=\"https://www.openstreetmap.org/copyright\" target=\"_blank\" rel=\"noopener\">OpenStreetMap</a>"
    }
  },
  "layers": [
    { "id": "background", "type": "background", "paint": { "background-color": "#f5f4f0" } },
    { "id": "opentopomap", "type": "raster", "source": "opentopomap", "paint": { "raster-opacity": 1 } }
  ]
}
